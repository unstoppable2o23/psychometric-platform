{
  "name": "psychometric-assessment-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx --tsconfig tsconfig.scripts.json src/server/db/migrate.ts",
    "db:seed": "tsx --tsconfig tsconfig.scripts.json src/server/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:probe": "tsx --tsconfig tsconfig.scripts.json src/server/db/probe.ts",
    "demo:report": "tsx --tsconfig tsconfig.scripts.json scripts/demo-report.mts",
    "inspect:pdf": "tsx --tsconfig tsconfig.scripts.json scripts/inspect-pdf.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@react-pdf/renderer": "^4.9.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "type": "module"
}

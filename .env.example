# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite database (development
# only). Point it at Supabase for a real deployment:
#   postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DATABASE_PGSSL=false

# Where the embedded database stores its files (development only).
PGLITE_DATA_DIR=.pglite

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# REQUIRED in production. At least 16 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
SESSION_COOKIE_NAME=psych_session
SESSION_TTL_HOURS=12

# Enables the passwordless local sign-in shown on an assignment link.
#
# OFF by default and refused in production regardless. A Server Action is a
# public POST endpoint, so gating this on NODE_ENV alone would leave it open on
# preview deployments or anywhere NODE_ENV is not exactly "production". Leaving
# this off in production is the safe default: you then get the "sign in with
# your school account" message instead of a passwordless bypass.
ALLOW_DEV_LOGIN=false

# ---------------------------------------------------------------------------
# Public URL (used to build assessment links shown to teachers)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Report storage
# ---------------------------------------------------------------------------
# MUST be outside `public/`. Reports are only reachable through the authorised
# download route. Use durable storage (a mounted volume, or object storage in
# production) rather than the local filesystem on serverless hosts.
REPORT_STORAGE_DIR=.reports

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# fake = local development gateway with no external calls
# razorpay = real integration (requires the keys below)
PAYMENT_PROVIDER=fake

# Required only when PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Rate limiting (per server process)
# ---------------------------------------------------------------------------
# RATE_LIMIT_PER_MINUTE applies to link resolution and sign-in attempts.
# Autosave uses a higher internal floor because a student legitimately sends
# many saves per minute. Counters are in-process, so on N instances the
# effective limit is N times this value; move the backing store to Redis to
# make it cluster-wide.
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Seeding (production only)
# ---------------------------------------------------------------------------
# When you seed a real database, set these so the super-admin and the first
# teacher do not end up with the well-known demo passwords. Ignored in
# development/test, where the demo defaults are used.
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=